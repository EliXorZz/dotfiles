{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "infomaniak/euria-code",
  "default_agent": "plan",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
    "graphify-opencode"
  ],
  "providers": {
    "infomaniak": {
      "name": "infomaniak",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:OPENAI_BASE_URL}"
      },
      "headers": {
        "X-LLM-Application-Tag": "codegpt",
        "Authorization": "Bearer {env:OPENAI_API_KEY}"
      },
      "models": {
        "euria-code": {
          "name": "euria-code",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 250000,
            "output": 100000
          },
          "cost": {
            "input": 0.6,
            "output": 3.0
          }
        },
        "euria-code-tiny": {
          "name": "euria-code-tiny",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 100000
          },
          "cost": {
            "input": 0.3,
            "output": 2.4
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "infomaniak/euria-code",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git status",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pwd",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "awk *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "awk *inplace*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "awk *system*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "sort *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "uniq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sed *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "osascript *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "xargs *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "*-exec*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "watch *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "env *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "sudo *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "su *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "doas *",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        }
      ]
    },
    "plan": {
      "model": "infomaniak/euria-code",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "git status",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "grep *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pwd",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "find *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "head *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "tail *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "awk *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "awk *inplace*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "awk *system*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "sort *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "uniq *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "wc *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "sed *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "osascript *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "xargs *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "*-exec*",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "watch *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "env *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "sudo *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "su *",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "doas *",
          "effect": "deny"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "ask"
        },
        {
          "action": "*_create_new_file",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "*_replace_text_in_file",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "*_rename_refactoring",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "*_reformat_file",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "*_execute_terminal_command",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "*_execute_run_configuration",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "*_build_project",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "*_execute_sql_query",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
