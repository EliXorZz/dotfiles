{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "infomaniak/euria-code",
  "default_agent": "Engineer",
  "mcp": {
    "servers": {
      "codebase-memory": {
        "type": "local",
        "command": ["npx", "-y", "codebase-memory-mcp@0.12.1"],
        "timeout": {
          "startup": 120000
        }
      }
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "providers": {
    "infomaniak": {
      "name": "infomaniak",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:OPENAI_BASE_URL}"
      },
      "headers": {
        "X-LLM-Application-Tag": "codegpt",
        "Authorization": "Bearer {env:OPENAI_API_KEY}"
      },
      "models": {
        "euria-code": {
          "name": "euria-code",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 250000,
            "output": 100000
          },
          "cost": {
            "input": 0.6,
            "output": 3.0
          }
        },
        "euria-code-tiny": {
          "name": "euria-code-tiny",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 100000
          },
          "cost": {
            "input": 0.3,
            "output": 2.4
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    }
  }
}
