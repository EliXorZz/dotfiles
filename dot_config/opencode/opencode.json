{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "share": "disabled",
  "provider": {
    "infomaniak": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "infomaniak",
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "headers": {
          "X-LLM-Application-Tag": "codegpt",
          "Authorization": "Bearer {env:OPENAI_API_KEY}"
        }
      },
      "models": {
        "euria-code": {
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "euria-code",
          "limit": {
            "context": 250000,
            "output": 100000
          },
          "cost": {
            "input": 0.6,
            "output": 3.0
          }
        },
        "euria-code-tiny": {
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "name": "euria-code-tiny",
          "limit": {
            "context": 200000,
            "output": 100000
          },
          "cost": {
            "input": 0.3,
            "output": 2.4
          }
        }
      }
    }
  },
  "model": "infomaniak/euria-code",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "infomaniak/euria-code",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git diff*": "allow",
          "git log *": "allow",
          "grep *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "find *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "awk *": "allow",
          "awk *inplace*": "ask",
          "awk *system*": "ask",
          "sort *": "allow",
          "uniq *": "allow",
          "wc *": "allow",
          "sed *": "ask",
          "osascript *": "ask",
          "xargs *": "ask",
          "*-exec*": "ask",
          "watch *": "ask",
          "env *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny"
        },
        "webfetch": "ask"
      }
    },
    "plan": {
      "model": "infomaniak/euria-code",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git diff*": "allow",
          "git log *": "allow",
          "grep *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "find *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "awk *": "allow",
          "awk *inplace*": "ask",
          "awk *system*": "ask",
          "sort *": "allow",
          "uniq *": "allow",
          "wc *": "allow",
          "sed *": "ask",
          "osascript *": "ask",
          "xargs *": "ask",
          "*-exec*": "ask",
          "watch *": "ask",
          "env *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny"
        },
        "webfetch": "ask",
        "*_create_new_file": "deny",
        "*_replace_text_in_file": "deny",
        "*_rename_refactoring": "deny",
        "*_reformat_file": "deny",
        "*_execute_terminal_command": "deny",
        "*_execute_run_configuration": "deny",
        "*_build_project": "deny",
        "*_execute_sql_query": "deny"
      }
    }
  }
}
