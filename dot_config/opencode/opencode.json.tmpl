{{- $elastic := list -}}
{{- range $name, $url := (output "sh" "-c" "cat $HOME/.config/opencode/es-clusters.json 2>/dev/null || echo {}" | fromJson) -}}
{{-   $srv := dict "type" "local" "command" (list "npx" "-y" "@elastic/mcp-server-elasticsearch@0.1.1") "environment" (dict "ES_URL" $url "ES_USERNAME" "{env:ES_USERNAME}" "ES_PASSWORD" "{env:ES_PASSWORD}") "timeout" (dict "startup" 120000) -}}
{{-   $elastic = append $elastic (printf "%s:%s" (toJson $name) (toJson $srv)) -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "infomaniak/euria-code",
  "default_agent": "Engineer",
  "permissions": [
    { "action": "es*", "resource": "*", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "codebase-memory": {
        "type": "local",
        "command": ["npx", "-y", "codebase-memory-mcp@0.12.1"],
        "timeout": {
          "startup": 120000
        }
      },
      "goland": {
        "type": "remote",
        "url": "http://127.0.0.1:64422/stream"
      },
      "phpstorm": {
        "type": "remote",
        "url": "http://127.0.0.1:64442/stream"
      }{{ if $elastic }},{{ join "," $elastic }}{{ end }}
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "providers": {
    "infomaniak": {
      "name": "infomaniak",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:OPENAI_BASE_URL}"
      },
      "headers": {
        "X-LLM-Application-Tag": "codegpt",
        "Authorization": "Bearer {env:OPENAI_API_KEY}"
      },
      "models": {
        "euria-code": {
          "name": "euria-code",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 250000,
            "output": 100000
          },
          "cost": {
            "input": 0.6,
            "output": 3.0
          }
        },
        "euria-code-tiny": {
          "name": "euria-code-tiny",
          "capabilities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 100000
          },
          "cost": {
            "input": 0.3,
            "output": 2.4
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    }
  }
}
