# General settings
accordion-padding = 0

after-startup-command = []
automatically-unhide-macos-hidden-apps = true

default-root-container-layout = "tiles"
default-root-container-orientation = "auto"

enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true
exec-on-workspace-change = []

on-focus-changed = []
on-focused-monitor-changed = ["move-mouse monitor-lazy-center"]

start-at-login = true

[gaps.inner]
horizontal = 0
vertical = 0

[gaps.outer]
bottom = 0
left = 0
right = 0
top = 0

[key-mapping]
preset = "qwerty"

# --- MAIN BINDINGS ---
[mode.main.binding]
alt-cmd-down = "focus down"
alt-cmd-left = "focus left"
alt-cmd-right = "focus right"
alt-cmd-up = "focus up"
alt-ctrl-down = "move down"
alt-ctrl-left = "move left"
alt-ctrl-right = "move right"
alt-ctrl-up = "move up"
alt-shift-p = "mode service"
alt-shift-tab = "move-workspace-to-monitor --wrap-around next"
alt-tab = "workspace-back-and-forth"
alt-x = "resize smart +50"
alt-y = "resize smart -50"
ctrl-1 = "workspace 1"
ctrl-2 = "workspace 2"
ctrl-3 = "workspace 3"
ctrl-4 = "workspace 4"
ctrl-5 = "workspace 5"
ctrl-6 = "workspace 6"
ctrl-7 = "workspace 7"
ctrl-8 = "workspace 8"
ctrl-9 = "workspace 9"
ctrl-shift-1 = "move-node-to-workspace 1 --focus-follows-window"
ctrl-shift-2 = "move-node-to-workspace 2 --focus-follows-window"
ctrl-shift-3 = "move-node-to-workspace 3 --focus-follows-window"
ctrl-shift-4 = "move-node-to-workspace 4 --focus-follows-window"
ctrl-shift-5 = "move-node-to-workspace 5 --focus-follows-window"
ctrl-shift-6 = "move-node-to-workspace 6 --focus-follows-window"
ctrl-shift-7 = "move-node-to-workspace 7 --focus-follows-window"
ctrl-shift-8 = "move-node-to-workspace 8 --focus-follows-window"
ctrl-shift-9 = "move-node-to-workspace 9 --focus-follows-window"

[mode.service.binding]
backspace = ["close-all-windows-but-current", "mode main"]
down = ["join-with down", "mode main"]
esc = ["reload-config", "mode main"]
f = ["layout floating tiling", "mode main"]
l = ["layout accordion", "mode main"]
left = ["join-with left", "mode main"]
r = ["flatten-workspace-tree", "mode main"]
right = ["join-with right", "mode main"]
up = ["join-with up", "mode main"]

# --- MONITOR ASSIGNMENTS ---
[workspace-to-monitor-force-assignment]
1 = "main"       # Workspace 1 (JetBrains) on main monitor
8 = "secondary"  # Workspace 8 KChat

# --- WINDOW RULES ---

{{- range (index .aerospace "floating-apps") }}
# Always floating
[[on-window-detected]]
if.app-id = '{{ index . "app-id" }}'
run = 'layout floating'

{{- end }}

# Floating workspaces
{{- range (index .aerospace "floating-workspaces") }}
[[on-window-detected]]
if.workspace = '{{ . }}'
run = 'layout floating'

{{- end }}

# App to workspace assignments
{{- range .aerospace.apps }}
{{- $ws := index . "workspace" }}
{{- $floating := false }}
{{- range (index $.aerospace "floating-workspaces") }}
{{- if eq (printf "%v" .) (printf "%v" $ws) }}{{- $floating = true }}{{- end }}
{{- end }}
[[on-window-detected]]
if.app-id = '{{ index . "app-id" }}'
{{- if $floating }}
run = ['layout floating', 'move-node-to-workspace {{ $ws }} --focus-follows-window']
{{- else }}
run = 'move-node-to-workspace {{ $ws }} --focus-follows-window'
{{- end }}

{{- end }}