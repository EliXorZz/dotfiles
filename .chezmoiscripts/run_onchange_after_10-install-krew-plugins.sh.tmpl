{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -x

{{- if .kubectl.enable }}
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

installed_plugins=$(kubectl-krew list | awk '$1 != "krew" {print $1}')
desired_plugins=(
{{- range .kubectl.plugins }}
    {{ . }}
{{- end }}
)

for plugin in "${desired_plugins[@]}"; do
    if ! echo "$installed_plugins" | grep -qx "$plugin"; then
        kubectl-krew install "$plugin"
    fi
done

for plugin in $installed_plugins; do
    if [[ ! " ${desired_plugins[*]} " =~ " ${plugin} " ]]; then
        kubectl-krew uninstall "$plugin"
    fi
done

# Create completion wrappers for krew plugins that support __complete.
# kubectl delegates plugin completion to kubectl_complete-<name> in PATH;
# cobra-based plugins support __complete, others (shell scripts) do not.
KREW_BIN="${KREW_ROOT:-$HOME/.krew}/bin"

for plugin_bin in "$KREW_BIN"/kubectl-*; do
    [ -x "$plugin_bin" ] || continue

    name=$(basename "$plugin_bin")

    # Skip existing completion wrappers
    [[ "$name" == kubectl_complete-* ]] && continue

    # Test if plugin supports __complete (cobra-based)
    if "$plugin_bin" __complete "" >/dev/null 2>&1; then
        comp_script="$KREW_BIN/kubectl_complete-${name#kubectl-}"
        cat > "$comp_script" << EOF
#!/bin/sh
$plugin_bin __complete "\$@"
EOF
        chmod +x "$comp_script"
    fi
done

{{ end -}}
{{ end -}}