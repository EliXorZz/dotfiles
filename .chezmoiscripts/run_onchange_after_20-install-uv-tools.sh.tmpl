{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -e
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

command -v uv >/dev/null 2>&1 || brew install uv

desired=(
{{ range .uv.tools }}
    {{ .name | quote }}
{{ end }}
)

for tool in "${desired[@]}"; do
    uv tool list 2>/dev/null | grep -qx "$tool" || uv tool install "$tool"
done

{{ range .uv.tools }}
{{- range .after }}
{{ . }} >/dev/null 2>&1 || true
{{- end }}
{{ end -}}

# Uninstall tools no longer declared
for tool in $(uv tool list 2>/dev/null | grep -v '^-' | awk '{print $1}'); do
    grep -qx "$tool" <<< "${desired[*]}" || uv tool uninstall "$tool"
done
{{- end }}
